# Copy to `.env` for local development, and add the same values in
# Vercel → Settings → Environment Variables for production.
# Full reference: README.md

# Canonical site origin (no trailing slash)
VITE_SITE_URL=https://creatoravgagency.in

# ---- EmailJS (shared across both forms) ----
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# ---- EmailJS · Brand Inquiry form (contact page) ----
VITE_EMAILJS_BRAND_TEMPLATE_ID=
VITE_EMAILJS_BRAND_AUTOREPLY_TEMPLATE_ID=

# ---- EmailJS · Creator Recruitment form (/join) ----
VITE_EMAILJS_CREATOR_TEMPLATE_ID=
VITE_EMAILJS_CREATOR_AUTOREPLY_TEMPLATE_ID=

# ---- WhatsApp ----
# Digits only, with country code, no "+" or spaces. e.g. 919876543210
VITE_WHATSAPP_NUMBER=

# ---- Analytics (load only after cookie consent) ----
VITE_GA4_ID=
VITE_META_PIXEL_ID=
